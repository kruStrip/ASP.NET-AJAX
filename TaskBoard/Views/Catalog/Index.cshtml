@model IReadOnlyList<TaskBoard.Models.Product>
@{
    ViewData["Title"] = "Каталог";
    var selected = ViewBag.Category as string;
    var categories = (string[])ViewBag.Categories;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div><h1 class="page-title mb-1">Витрина товаров</h1><p class="text-muted mb-0">Выберите что-нибудь для себя</p></div>
    <div class="d-flex flex-wrap gap-2" aria-label="Фильтр по категориям">
        <a class="btn btn-sm @(selected is null ? "btn-primary" : "btn-outline-secondary") filter-tag" href="/catalog">Все</a>
        @foreach (var category in categories)
        { <a class="btn btn-sm @(selected == category ? "btn-primary active" : "btn-outline-secondary") filter-tag" href="/catalog?category=@Uri.EscapeDataString(category)">@category</a> }
    </div>
</div>

@if (TempData["CartMessage"] is string message)
{
    <div class="alert alert-@(TempData["CartMessageType"] ?? "success") alert-dismissible fade show" role="alert">
        @message <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
    </div>
}

<div class="row g-4">
@foreach (var product in Model)
{
    var discount = product.OldPrice.HasValue ? (int)Math.Round((1 - product.Price / product.OldPrice.Value) * 100) : 0;
    var borderClass = product.Stock == 0 ? "border-danger" : discount > 30 ? "border-success" : "border-light";
    var badgeClass = product.Stock == 0 ? "bg-danger" : product.IsHit ? "bg-success" : discount > 30 ? "bg-success" : "bg-secondary";
    <div class="col-12 col-md-6 col-lg-4">
        <article class="card h-100 product-card @borderClass @(product.IsHit ? "shadow-sm" : "")">
            <div class="position-relative"><img src="@product.Image" class="card-img-top img-fluid product-image" alt="@product.Name" />
                <span class="badge @badgeClass position-absolute top-0 end-0 m-3">@(product.Stock == 0 ? "Нет в наличии" : product.IsHit ? "ХИТ" : discount > 30 ? "Большая скидка" : product.Category)</span>
            </div>
            <div class="card-body d-flex flex-column"><h2 class="h5 card-title">@product.Name</h2><p class="card-text text-muted">@product.Description</p>
                <div class="list-group list-group-horizontal-md list-group-flush small mb-3"><div class="list-group-item px-0">Цена: <strong class="fs-5 text-dark">@product.Price.ToString("N0") ₽</strong></div>@if(product.OldPrice.HasValue){<div class="list-group-item px-0 text-decoration-line-through text-muted">Было: @product.OldPrice.Value.ToString("N0") ₽</div>}</div>
                <form class="mt-auto" method="post" action="/catalog/addtocart"><input type="hidden" name="id" value="@product.Id" /><input type="hidden" name="category" value="@selected" /><button class="btn btn-primary w-100" disabled="@(product.Stock == 0 ? "disabled" : null)">@(product.Stock == 0 ? "Нет в наличии" : "В корзину")</button></form>
            </div>
        </article>
    </div>
}
</div>
