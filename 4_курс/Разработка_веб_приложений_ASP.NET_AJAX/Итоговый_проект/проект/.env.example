# Local development ONLY. Copy to .env and choose unique passwords.
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
# Optional. If omitted, Development seeds admin@muzloto.local / Admin2026! (local only).
MUZLOTO_ADMIN_EMAIL=
MUZLOTO_ADMIN_PASSWORD=
MUZLOTO_INTEGRATION_SECRET=REPLACE_WITH_RANDOM_LONG_SECRET

# At least 32 random UTF-8 bytes. Required for API JWT.
MUZLOTO_JWT_KEY=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES

# Optional: manager notifications in Telegram. Create a bot with @BotFather, add it to the group,
# and put its token, the group id (starts with -100) and the ids of the «Подтвердить игру» and
# «Связаться с клиентом» topics here.
# Without these the notification waits in the queue and nothing is sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_MANAGER_TOPIC_ID=
TELEGRAM_CONTACT_TOPIC_ID=
# Optional: staff notices about edits («Изменения в бронях») and cancellations («Отмена игр»).
# Without them such notices go to the group's General topic instead of waiting.
TELEGRAM_CHANGES_TOPIC_ID=
TELEGRAM_CANCEL_TOPIC_ID=
# Optional: Telegram Bot API relay. The production server cannot reach api.telegram.org (Telegram is
# blocked for the hosting), so the bot calls go through a small Cloudflare Worker
# (deploy/cloudflare-worker) — put its URL and the shared secret here. Empty = call api.telegram.org.
# Through a relay a receipt is not uploaded: the site posts its signed link to {relay}/send-file and the
# Worker downloads the file itself (the provider drops request bodies over ~10 KB to *.workers.dev).
TELEGRAM_API_BASE_URL=
TELEGRAM_RELAY_SECRET=

