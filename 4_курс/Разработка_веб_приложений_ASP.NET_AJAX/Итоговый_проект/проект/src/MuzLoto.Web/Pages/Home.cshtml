@page "/"
@model MuzLoto.Web.Pages.HomeModel
@using System.Globalization
@{ ViewData["Title"] = "Запись на игру"; var s = Model.Selected; }
<section class="panel booking-form">
    <img class="booking-logo" src="~/img/logo.jpg" asp-append-version="true" alt="МузЛото" width="200" height="200" />
    @if (s is null)
    {
        <h1>Запись на игру</h1>
        <p>Сейчас нет открытых игр. Загляните позже!</p>
    }
    else if (Model.Step == HomeModel.Steps.Review)
    {
        <h1 class="center">Пожалуйста, перепроверьте</h1>
        <dl class="review">
            <div><dt>Название игры:</dt><dd>@s.Title</dd></div>
            <div><dt>Дата игры:</dt><dd>@s.Date, @s.Time</dd></div>
            <div><dt>Телефон:</dt><dd>@Model.Input.Phone</dd></div>
            <div><dt>Имя:</dt><dd>@Model.Input.Name</dd></div>
            @if (Model.Input.Telegram is not null) { <div><dt>Telegram:</dt><dd>@Model.Input.Telegram</dd></div> }
            <div><dt>Название команды:</dt><dd>@Model.Input.Team</dd></div>
            <div><dt>Количество билетов:</dt><dd>@Model.Input.Quantity</dd></div>
            <div><dt>Итого:</dt><dd>@Model.Total.ToString("#,0.##") ₽</dd></div>
        </dl>
        <form method="post">
            <input type="hidden" asp-for="Input.SessionId" />
            <input type="hidden" asp-for="Input.SubmissionKey" />
            <input type="hidden" asp-for="Input.Quantity" />
            <input type="hidden" asp-for="Input.Name" />
            <input type="hidden" asp-for="Input.Phone" />
            <input type="hidden" asp-for="Input.Telegram" />
            <input type="hidden" asp-for="Input.Team" />
            <input type="hidden" asp-for="Input.AcceptPrivacy" />
            <div class="actions center">
                <button type="submit" class="button secondary" asp-page-handler="Edit">Назад</button>
                <button type="submit" class="button" asp-page-handler="Submit">К оплате</button>
            </div>
        </form>
    }
    else
    {
        <div asp-validation-summary="ModelOnly" class="error-text"></div>
        @* Choosing a date reloads the card (site.js submits on change; without JS — the «Показать» button). *@
        <form method="get" class="date-pick">
            <label for="game">Выберите дату <span class="req">*</span></label>
            <select id="game" name="game" data-autosubmit>
                @foreach (var o in Model.Offers) { <option value="@o.Id" selected="@(o.Id == s.Id)">@o.Label</option> }
            </select>
            <noscript><button type="submit" class="small-button">Показать</button></noscript>
        </form>

        @if (s.CoverUrl is not null) { <img class="booking-cover" src="@s.CoverUrl" alt="Афиша: @s.Title" /> }
        <h2 class="center">@s.Title</h2>
        @if (s.Descriptions.Count > 0)
        {
            <div class="game-text">@foreach (var line in s.Descriptions) { <p>@line</p> }</div>
        }
        <dl class="game-facts">
            <div><dt>Дата:</dt><dd>@s.Date</dd></div>
            <div><dt>Время:</dt><dd>@s.Time</dd></div>
            <div><dt>Цена:</dt><dd>@s.Price.ToString("#,0.##") ₽/чел</dd></div>
            <div><dt>Локация:</dt><dd>@if (s.MapUrl is not null) { <a href="@s.MapUrl" target="_blank" rel="noopener noreferrer">@s.Venue</a> } else { @s.Venue }</dd></div>
            <div><dt>Продолжительность:</dt><dd>@PublicSchedule.Duration(s.DurationMinutes)</dd></div>
            <div><dt>Возрастное ограничение:</dt><dd>@(s.AgeLimit)+</dd></div>
        </dl>
        <p class="seats">Кол-во билетов доступных для покупки: <strong>@s.Remaining</strong></p>

        @if (s.MaxQuantity < 1)
        {
            <p class="alert error">Билеты на эту дату закончились. Выберите другую дату.</p>
        }
        else
        {
            <form method="post" asp-page-handler="Review" class="booking-fields">
                <input type="hidden" asp-for="Input.SessionId" />
                <input type="hidden" asp-for="Input.SubmissionKey" />
                <div class="hp" aria-hidden="true"><label for="website">Сайт</label><input id="website" name="Input.Website" tabindex="-1" autocomplete="off" /></div>

                <label asp-for="Input.Quantity">Выберите кол-во билетов <span class="req">*</span></label>
                <select asp-for="Input.Quantity" data-price="@s.Price.ToString(CultureInfo.InvariantCulture)" data-total-target="#total">
                    <option value="">Не выбрано</option>
                    @for (var i = 1; i <= s.MaxQuantity; i++) { <option value="@i">@i</option> }
                </select>
                <span asp-validation-for="Input.Quantity" class="error-text"></span>

                <label asp-for="Input.Name">Введите ваше имя <span class="req">*</span></label>
                <input asp-for="Input.Name" placeholder="Имя" autocomplete="name" maxlength="150" />
                <span asp-validation-for="Input.Name" class="error-text"></span>

                <label asp-for="Input.Phone">Введите ваш телефон <span class="req">*</span></label>
                <input asp-for="Input.Phone" type="tel" placeholder="+7 900 000-00-00" autocomplete="tel" maxlength="40" />
                <span asp-validation-for="Input.Phone" class="error-text"></span>

                <label asp-for="Input.Telegram">Введите ваш Telegram ник</label>
                <input asp-for="Input.Telegram" placeholder="Например: @@username. Не указывайте почту или ссылку." maxlength="100" />
                <span asp-validation-for="Input.Telegram" class="error-text"></span>

                <label asp-for="Input.Team">Введите название команды <span class="req">*</span></label>
                <input asp-for="Input.Team" maxlength="150" />
                <span asp-validation-for="Input.Team" class="error-text"></span>

                <label for="total">Итого к оплате</label>
                <input id="total" value="@Model.Total.ToString("#,0.##") ₽" readonly tabindex="-1" />

                <label class="check"><input asp-for="Input.AcceptPrivacy" /> <span>Я даю согласие на обработку персональных данных и ознакомлен(а) с
                @if (LinkRules.IsHttpUrl(Model.PrivacyPolicyUrl)) { <a href="@Model.PrivacyPolicyUrl" target="_blank" rel="noopener noreferrer">Политикой в отношении обработки персональных данных</a> } else { <span>Политикой в отношении обработки персональных данных</span> }</span></label>
                <span asp-validation-for="Input.AcceptPrivacy" class="error-text"></span>

                <button type="submit" class="button">Дальше</button>
            </form>
        }
    }
</section>
