@page "/messengers"
@model MuzLoto.Web.Pages.Messengers.IndexModel
@using MuzLoto.Web.Domain
@{
    ViewData["Title"] = "Мессенджеры";
    var states = new[] { ("Telegram", Model.TelegramState), ("WhatsApp", Model.WhatsAppState) };
}
<div class="page-heading"><div><div class="eyebrow">Управление</div><h1>Мессенджеры</h1>
<p class="muted">Когда оплата подтверждена, клиенту уходит сообщение «Ваша игра подтверждена» в Telegram и WhatsApp.
Отправляет сервис Wazzup: аккаунты подключаются в его кабинете, сайт лишь передаёт ему текст. Сообщения уходят по очереди с паузой.</p></div></div>

<section class="panel">
    <h2>Каналы Wazzup</h2>
    @if (!Model.Configured)
    {
        <p class="alert error">Сайт не подключён к Wazzup: на сервере в <code>.env</code> не задан <code>WAZZUP_API_KEY</code>.</p>
    }
    <p>Подключение — один раз, в кабинете <a href="https://app.wazzup24.ru/" rel="noopener noreferrer" target="_blank">app.wazzup24.ru</a>:</p>
    <ol>
        <li>Зарегистрируйтесь и подключите каналы: номер <b>WhatsApp</b> и аккаунт <b>Telegram</b> (для Telegram лучше именно аккаунт, не бота — бот не может писать клиентам первым). QR-коды сканируют там же.</li>
        <li>Раздел «Интеграция с CRM» → <b>API</b> → «Подключить» → скопируйте ключ API.</li>
        <li>Положите ключ на сервер в <code>.env</code> как <code>WAZZUP_API_KEY</code> и перезапустите: <code>docker compose up -d</code>.</li>
    </ol>
    <p class="muted">Необязательно: если в Wazzup несколько каналов одного типа, закрепите нужный в <code>WAZZUP_WHATSAPP_CHANNEL_ID</code> / <code>WAZZUP_TELEGRAM_CHANNEL_ID</code> (ID видны ниже).</p>

    @foreach (var (name, state) in states)
    {
        <h3>@name</h3>
        <p>Состояние: <b>@IndexModel.StateText(state.Status)</b>@if (state.Detail is { } d) { <span> — @d</span> }</p>
    }

    @if (Model.TelegramState.Channels.Count > 0 || Model.WhatsAppState.Channels.Count > 0)
    {
        var channels = Model.TelegramState.Channels.Count > 0 ? Model.TelegramState.Channels : Model.WhatsAppState.Channels;
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Канал</th><th>Номер / аккаунт</th><th>Состояние</th><th>ID</th></tr></thead>
            <tbody>
            @foreach (var c in channels)
            {
                <tr>
                    <td>@IndexModel.TransportText(c.Transport)</td>
                    <td>@(c.PlainId ?? "—")</td>
                    <td>@IndexModel.StateText(c.State)</td>
                    <td><code>@c.ChannelId</code></td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</section>

<section class="panel">
    <h2>Последние сообщения</h2>
    <div class="table-wrap"><table class="table">
        <thead><tr><th>Команда и игра</th><th>Канал</th><th>Статус</th><th>Когда</th><th></th></tr></thead>
        <tbody>
        @foreach (var m in Model.Recent)
        {
            <tr>
                <td>@m.Booking.TeamName — @m.Booking.GameSession.Game.Title<br /><span class="muted">@m.Booking.Phone @m.Booking.Telegram</span></td>
                <td>@m.Channel</td>
                <td>@IndexModel.StatusText(m.Status)@if (m.LastError is not null) { <br /><span class="muted">@m.LastError</span> }</td>
                <td>@ScheduleTime.Format(m.SentAt ?? m.CreatedAt, ScheduleTime.DefaultTimeZone)</td>
                <td>@if (m.Status is OutgoingMessageStatus.Failed or OutgoingMessageStatus.Skipped)
                    { <form method="post" asp-page-handler="Retry"><input type="hidden" name="id" value="@m.Id" /><button class="small-button" type="submit">Повторить</button></form> }</td>
            </tr>
        }
        </tbody>
    </table></div>
    @if (Model.Recent.Count == 0) { <p class="muted">Сообщений пока не было.</p> }
</section>
