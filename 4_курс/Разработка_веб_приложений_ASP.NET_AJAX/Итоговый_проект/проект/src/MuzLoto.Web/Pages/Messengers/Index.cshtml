@page "/messengers"
@model MuzLoto.Web.Pages.Messengers.IndexModel
@using MuzLoto.Web.Domain
@{ ViewData["Title"] = "Мессенджеры"; var tg = Model.Telegram; }
<div class="page-heading"><div><div class="eyebrow">Управление</div><h1>Мессенджеры</h1>
<p class="muted">Когда оплата подтверждена, клиенту уходит сообщение «Ваша игра подтверждена» в Telegram и WhatsApp.
Сообщения отправляются по очереди с паузой, чтобы мессенджеры не сочли это рассылкой.</p></div></div>

<section class="panel">
    <h2>Telegram</h2>
    @if (!tg.IsConfigured)
    {
        <p>Не настроен. На сервере в <code>.env</code> нужны <code>TELEGRAM_API_ID</code> и <code>TELEGRAM_API_HASH</code> — ключи приложения с my.telegram.org.</p>
    }
    else if (tg.WaitingForScan)
    {
        <p>Откройте Telegram на телефоне, с аккаунта которого будут уходить сообщения: <b>Настройки → Устройства → Подключить устройство</b>, и наведите камеру на код.
        Страница обновится сама, когда аккаунт подключится.</p>
        @if (tg.QrUrl is not null) { <img class="pay-qr" src="@Url.Page(null, "TelegramQr")&t=@DateTime.UtcNow.Ticks" alt="QR-код для подключения Telegram" data-refresh-seconds="10" /> }
        else { <p class="muted" data-refresh-seconds="3">Готовим QR-код…</p> }
    }
    else if (Model.TelegramReady)
    {
        <p>Подключён: <b>@tg.AccountName</b>. Сообщения уходят с этого аккаунта.</p>
        <form method="post" asp-page-handler="TelegramLogout" data-confirm="Отключить Telegram? Новые сообщения будут ждать повторного подключения.">
            <button type="submit" class="button secondary">Отключить</button></form>
    }
    else
    {
        @if (tg.LoginError is not null) { <p class="alert error">@tg.LoginError</p> }
        <form method="post" asp-page-handler="TelegramQr" class="slot-form">
            <label for="tg-password">Пароль двухэтапной проверки Telegram — только если он включён на этом аккаунте</label>
            <input id="tg-password" name="password" type="password" autocomplete="off" />
            <div><button type="submit" class="button">Показать QR-код</button></div>
        </form>
    }
</section>

<section class="panel">
    <h2>WhatsApp — отдельный номер</h2>
    <p>Состояние: <b>@IndexModel.WhatsAppText(Model.WhatsApp.Status)</b>@if (Model.WhatsApp.Account is not null) { <span> — @Model.WhatsApp.Account</span> }</p>
    @if (Model.WhatsApp.Status == "STARTING") { <p class="muted" data-refresh-seconds="3">Готовим QR-код…</p> }
    @if (Model.WhatsApp.Status == "SCAN_QR_CODE")
    {
        <p>Откройте WhatsApp на телефоне с этим номером → «Связанные устройства» → «Привязка устройства» и отсканируйте код. Страница обновится, когда номер подключится.</p>
        <img class="pay-qr" src="@Url.Page(null, "WhatsAppQr")&t=@DateTime.UtcNow.Ticks" alt="QR-код для подключения WhatsApp" data-refresh-seconds="20" />
    }
    @if (Model.WhatsApp.Status is "NONE" or "STOPPED" or "FAILED")
    {
        <form method="post" asp-page-handler="WhatsAppStart"><button type="submit" class="button">Показать QR-код</button></form>
    }
    else if (Model.WhatsApp.Status is "STARTING" or "SCAN_QR_CODE")
    {
        @* A start that hangs (or a code nobody scanned) can always be begun again. *@
        <form method="post" asp-page-handler="WhatsAppStart"><button type="submit" class="button secondary">Перезапустить</button></form>
    }
    @if (Model.WhatsApp.Status == "WORKING")
    {
        <form method="post" asp-page-handler="WhatsAppLogout" data-confirm="Отключить WhatsApp? Новые сообщения будут ждать повторного подключения.">
            <button type="submit" class="button secondary">Отключить</button></form>
    }
</section>

<section class="panel">
    <h2>Последние сообщения</h2>
    <div class="table-wrap"><table class="table">
        <thead><tr><th>Команда и игра</th><th>Канал</th><th>Статус</th><th>Когда</th><th></th></tr></thead>
        <tbody>
        @foreach (var m in Model.Recent)
        {
            <tr>
                <td>@m.Booking.TeamName — @m.Booking.GameSession.Game.Title<br /><span class="muted">@m.Booking.Phone @m.Booking.Telegram</span></td>
                <td>@m.Channel</td>
                <td>@IndexModel.StatusText(m.Status)@if (m.LastError is not null) { <br /><span class="muted">@m.LastError</span> }</td>
                <td>@ScheduleTime.Format(m.SentAt ?? m.CreatedAt, ScheduleTime.DefaultTimeZone)</td>
                <td>@if (m.Status is OutgoingMessageStatus.Failed or OutgoingMessageStatus.Skipped)
                    { <form method="post" asp-page-handler="Retry"><input type="hidden" name="id" value="@m.Id" /><button class="small-button" type="submit">Повторить</button></form> }</td>
            </tr>
        }
        </tbody>
    </table></div>
    @if (Model.Recent.Count == 0) { <p class="muted">Сообщений пока не было.</p> }
</section>
