@page "/form-images"
@model MuzLoto.Web.Pages.FormImages.IndexModel
@{ ViewData["Title"] = "Картинки для формы"; }
<div class="page-heading"><div><div class="eyebrow">FormDesigner</div><h1>Картинки для формы</h1>
<p class="muted">Десять постоянных ссылок. Вставьте ссылку в форму один раз — дальше меняйте картинку здесь, ссылка останется прежней.
Новая картинка видна сразу — кэш браузера чистить не нужно. JPEG, PNG или WebP до 5 МБ.</p></div></div>
<div class="slot-grid">
@foreach (var row in Model.Rows)
{
    var slot = row.Slot;
    <article class="booking-card slot-card">
        <div class="slot-preview">
            @if (slot is not null) { <img src="/i/@row.Number?v=@slot.Version" alt="Картинка ссылки №@row.Number" loading="lazy" /> }
            else { <span class="muted">Пусто</span> }
        </div>
        <div class="slot-body">
            <h2>Ссылка №@row.Number</h2>
            <div class="copy-row">
                <input type="text" value="@row.PublicUrl" readonly aria-label="Ссылка №@row.Number" />
                <button type="button" class="button secondary" data-copy="@row.PublicUrl">Скопировать</button>
            </div>
            @if (slot is not null) { <p class="muted">Обновлено @ScheduleTime.Format(slot.UpdatedAt, ScheduleTime.DefaultTimeZone) · версия @slot.Version</p> }
            <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="slot-form">
                <input type="hidden" name="number" value="@row.Number" />
                <label for="note-@row.Number">Подпись (для себя)</label>
                <input id="note-@row.Number" name="note" value="@slot?.Note" maxlength="100" placeholder="Например: 05.11 — Хиты 2000-х" />
                <label for="image-@row.Number">@(slot is null ? "Загрузить картинку" : "Заменить картинку")</label>
                <input id="image-@row.Number" name="image" type="file" accept="image/jpeg,image/png,image/webp" />
                <div class="actions">
                    <button type="submit" class="button">@(slot is null ? "Загрузить" : "Сохранить")</button>
                    @if (slot is not null)
                    {
                        <button type="submit" class="button secondary" asp-page-handler="Note">Только подпись</button>
                        <button type="submit" class="button danger" asp-page-handler="Delete" formnovalidate
                                data-confirm-button="Удалить картинку ссылки №@row.Number? В форме на её месте будет пусто.">Удалить</button>
                    }
                </div>
            </form>
        </div>
    </article>
}
</div>
