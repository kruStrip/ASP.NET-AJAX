@page "/bookings/pending"
@model MuzLoto.Web.Pages.Bookings.PendingModel
@{ ViewData["Title"] = "Нужно подтвердить"; }
<div class="page-heading"><div><div class="eyebrow">Поступившие заявки</div><h1>Нужно подтвердить</h1>
<p class="muted">Сюда попадают заявки, по которым клиент уже прислал чек. Заявки не занимают места до подтверждения оплаты сотрудником. Внизу отдельно показаны перенесённые из Google Sheets заявки без чека.</p></div></div>
<partial name="_BookingSearch" model="Model.Q" />
<div class="card-list" data-live-list>
@foreach (var b in Model.Bookings)
{
<partial name="_PendingCard" model="new MuzLoto.Web.Pages.Bookings.PendingCard(b, Model.RemainingBySession.GetValueOrDefault(b.GameSessionId), false)" />
}
@if (Model.Bookings.Count == 0) { <p class="muted">@(string.IsNullOrWhiteSpace(Model.Q) ? "Заявок с чеком на проверку нет." : "Ничего не найдено.")</p> }
@if (Model.ImportedWithoutReceipt.Count > 0)
{
<div class="panel">
<div class="eyebrow">Перенесённые заявки</div><h2>Без чека</h2>
<p class="muted">Эти заявки перенесены из Google Sheets: у клиента нет аккаунта на сайте, поэтому чек от него не придёт. Перед подтверждением проверьте оплату другим способом.</p>
</div>
foreach (var b in Model.ImportedWithoutReceipt)
{
<partial name="_PendingCard" model="new MuzLoto.Web.Pages.Bookings.PendingCard(b, Model.RemainingBySession.GetValueOrDefault(b.GameSessionId), true)" />
}
}
</div>

@foreach (var sessionId in Model.AccessibleSessionIds) { <span hidden data-signalr-session="@sessionId"></span> }
