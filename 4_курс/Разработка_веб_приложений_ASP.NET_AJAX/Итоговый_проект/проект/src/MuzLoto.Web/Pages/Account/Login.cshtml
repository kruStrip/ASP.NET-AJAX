@page "/account/login"
@model MuzLoto.Web.Pages.Account.LoginModel
@{ ViewData["Title"] = "Вход"; }
<section class="login panel"><div class="eyebrow">Учётная запись</div><h1>Вход в МузЛото</h1>
<form method="post">
<div asp-validation-summary="ModelOnly" class="error-text"></div>
<label asp-for="Input.Login">Телефон или e-mail</label><input asp-for="Input.Login" autocomplete="username" placeholder="+7 900 000-00-00 или name@mail.ru" /><span asp-validation-for="Input.Login" class="error-text"></span>
<label asp-for="Input.Password">Пароль</label><input asp-for="Input.Password" type="password" autocomplete="current-password" /><span asp-validation-for="Input.Password" class="error-text"></span>
<button type="submit" class="button">Войти</button>
</form>
<p class="muted">Нет аккаунта? <a asp-page="/Account/Register">Зарегистрироваться</a></p>
</section>
