@page "/account/change-password"
@model MuzLoto.Web.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = "Сменить пароль"; }
<div class="page-heading"><div><div class="eyebrow">Настройки аккаунта</div><h1>Сменить пароль</h1></div></div>
<section class="panel form-panel"><form method="post">
<div asp-validation-summary="All" class="error-text"></div>
<label asp-for="Input.CurrentPassword">Текущий пароль</label><input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" />
<label asp-for="Input.NewPassword">Новый пароль (от 12 символов)</label><input asp-for="Input.NewPassword" type="password" autocomplete="new-password" />
<label asp-for="Input.ConfirmPassword">Повторите новый пароль</label><input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
<button class="button" type="submit">Сохранить пароль</button>
</form></section>
