@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject IConfiguration Config
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] — МузЛото</title>
    <link rel="icon" href="~/img/favicon.png" asp-append-version="true" type="image/png" sizes="64x64" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var isStaff = User.IsInRole("Admin") || User.IsInRole("Manager");
    var isAdmin = User.IsInRole("Admin");
    var signedIn = User.Identity?.IsAuthenticated == true;
    var currentPage = ViewContext.RouteData.Values["page"] as string;
    // A section stays highlighted on its own sub-pages (game card, sales history, assignments…).
    string? Active(params string[] pages) =>
        pages.Any(p => string.Equals(p, currentPage, StringComparison.OrdinalIgnoreCase)) ? "active" : null;
    string? Current(params string[] pages) => Active(pages) is null ? null : "page";
}
<body data-hub="@(isStaff ? "booking" : null)" class="@(signedIn ? "with-sidebar" : null)">
@if (signedIn)
{
@* Phones and tablets: a top bar with a menu button; the sidebar slides in as a drawer (works without JS via #sidebar). *@
<header class="mobile-bar">
    <a href="#sidebar" class="menu-toggle" aria-controls="sidebar" aria-expanded="false" aria-label="Открыть меню"><span></span><span></span><span></span></a>
    <a class="brand" asp-page="@(isStaff ? "/Index" : "/Home")"><img src="~/img/logo.jpg" asp-append-version="true" alt="@(isStaff ? "МузЛото — главная панель" : "МузЛото — на главную")" width="40" height="40" /></a>
    @if (isStaff) { <span class="online" data-online-count hidden></span> }
</header>
<aside class="sidebar" id="sidebar">
    <a href="#" class="menu-close" aria-label="Закрыть меню">×</a>
    <a class="brand" asp-page="@(isStaff ? "/Index" : "/Home")"><img src="~/img/logo.jpg" asp-append-version="true" alt="@(isStaff ? "МузЛото — главная панель" : "МузЛото — на главную")" width="48" height="48" /></a>
    <nav class="side-nav" aria-label="Основная навигация">
        @if (isStaff)
        {
            <span class="side-group">Заявки</span>
            <a asp-page="/Bookings/Pending" class="@Active("/Bookings/Pending")" aria-current="@Current("/Bookings/Pending")">Подтвердить игру</a>
            <a asp-page="/Bookings/Confirmed" class="@Active("/Bookings/Confirmed", "/Bookings/History")" aria-current="@Current("/Bookings/Confirmed", "/Bookings/History")">Подтверждённые игры</a>
            <a asp-page="/Bookings/Cancelled" class="@Active("/Bookings/Cancelled")" aria-current="@Current("/Bookings/Cancelled")">Отменённые игры</a>
            @if (isAdmin) { <a asp-page="/Refunds/Index" class="@Active("/Refunds/Index")" aria-current="@Current("/Refunds/Index")">Возвраты</a> }

            <span class="side-group">Мероприятия</span>
            <a asp-page="/Events/Index" class="@Active("/Events/Index", "/Events/Details", "/Events/Edit", "/Events/Create")" aria-current="@Current("/Events/Index", "/Events/Details", "/Events/Edit", "/Events/Create")">Текущие игры</a>

            @if (isAdmin)
            {
                <span class="side-group">Управление</span>
                <a asp-page="/Reports/Index" class="@Active("/Reports/Index")" aria-current="@Current("/Reports/Index")">Отчёт</a>
                <a asp-page="/Staff/Index" class="@Active("/Staff/Index", "/Staff/Assignments")" aria-current="@Current("/Staff/Index", "/Staff/Assignments")">Сотрудники</a>
                <a asp-page="/PaymentSettings/Index" class="@Active("/PaymentSettings/Index")" aria-current="@Current("/PaymentSettings/Index")">Оплата</a>
            }
        }
        <span class="side-group">Аккаунт</span>
        <a asp-page="/Home" class="@Active("/Home")" aria-current="@Current("/Home")">Форма записи</a>
        <a asp-page="/Bookings/Mine" class="@Active("/Bookings/Mine", "/Bookings/Edit")" aria-current="@Current("/Bookings/Mine", "/Bookings/Edit")">Мои заявки</a>
        <a asp-page="/Account/ChangePassword" class="@Active("/Account/ChangePassword")" aria-current="@Current("/Account/ChangePassword")">Сменить пароль</a>
    </nav>
    <div class="side-user">
        @if (isStaff) { <span class="online" data-online-count hidden></span> }
        <span class="user-name" title="Вы вошли как">@User.Identity!.Name</span>
        <form method="post" asp-page="/Account/Logout"><button type="submit" class="small-button">Выйти</button></form>
    </div>
</aside>
<a href="#" class="menu-backdrop" aria-hidden="true" tabindex="-1"></a>
}
else
{
<header class="topbar">
    <a class="brand" asp-page="/Home"><img src="~/img/logo.jpg" asp-append-version="true" alt="МузЛото — на главную" width="48" height="48" /></a>
    <nav class="nav" aria-label="Основная навигация">
        <a asp-page="/Account/Login">Войти</a>
        <a asp-page="/Account/Register">Регистрация</a>
    </nav>
</header>
}
<main class="content">
    <div id="ajax-notice" class="alert" role="status" aria-live="polite" hidden></div>
    @if (TempData["Notice"] is string notice) { <div class="alert success">@notice</div> }
    @if (TempData["Error"] is string error) { <div class="alert error">@error</div> }
    @RenderBody()
</main>
<footer class="footer">
    <span>© @DateTime.Now.Year МузЛото</span>
    @if (LinkRules.IsHttpUrl(Config["Legal:PrivacyPolicyUrl"])) { <a href="@Config["Legal:PrivacyPolicyUrl"]" target="_blank" rel="noopener noreferrer">Политика обработки персональных данных</a> }
    <span class="muted">Система мероприятий и продажи билетов</span>
</footer>
<script src="~/lib/signalr/signalr.min.js" defer></script>
<script src="~/js/site.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
