@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] — МузЛото</title>
    <link rel="icon" href="~/img/favicon.png" asp-append-version="true" type="image/png" sizes="64x64" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{ var isStaff = User.IsInRole("Admin") || User.IsInRole("Manager"); }
<body data-hub="@(isStaff ? "booking" : null)">
<header class="topbar">
    <a class="brand" asp-page="/Home"><img src="~/img/logo.jpg" asp-append-version="true" alt="МузЛото — на главную" width="48" height="48" /></a>
    <nav class="nav" aria-label="Основная навигация">
        @if (User.Identity?.IsAuthenticated == true)
        {
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <a asp-page="/Index">Главная</a>
                <a asp-page="/Bookings/Pending">Подтверждение</a>
                <a asp-page="/Bookings/Confirmed">Покупки</a>
                <a asp-page="/Bookings/Cancelled">Отменённые</a>
                @if (User.IsInRole("Admin")) { <a asp-page="/Refunds/Index">Возвраты</a> }
                <a asp-page="/Events/Index">Игры</a>
                <a asp-page="/Events/Complete">Завершить</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-page="/Reports/Index">Отчёт</a>
                    <a asp-page="/Staff/Index">Сотрудники</a>
                }
            }
            <a asp-page="/Bookings/Mine">Мои заявки</a>
            <a asp-page="/Account/ChangePassword">Пароль</a>
        }
        else
        {
            <a asp-page="/Account/Login">Войти</a>
            <a asp-page="/Account/Register">Регистрация</a>
        }
    </nav>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="user-box">
            @if (isStaff) { <span class="online" data-online-count hidden></span> }
            <span class="user-name" title="Вы вошли как">@User.Identity.Name</span>
            <form method="post" asp-page="/Account/Logout"><button type="submit" class="small-button">Выйти</button></form>
        </div>
    }
</header>
<main class="content">
    <div id="ajax-notice" class="alert" role="status" aria-live="polite" hidden></div>
    @if (TempData["Notice"] is string notice) { <div class="alert success">@notice</div> }
    @if (TempData["Error"] is string error) { <div class="alert error">@error</div> }
    @RenderBody()
</main>
<footer class="footer">
    <span>© @DateTime.Now.Year МузЛото</span>
    <span class="muted">Система мероприятий и продажи билетов</span>
</footer>
@if (User.Identity?.IsAuthenticated == true)
{
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
    <nav class="bottom-nav" aria-label="Мобильное меню">
        <a asp-page="/Bookings/Confirmed">Покупки</a>
        <a asp-page="/Bookings/Pending">Ожидают</a>
        <a asp-page="/Events/Index">Игры</a>
        <a asp-page="/Events/Complete">Завершить</a>
        @if (User.IsInRole("Admin")) { <a asp-page="/Staff/Index">Сотрудники</a> }
    </nav>
    }
}
<script src="~/lib/signalr/signalr.min.js" defer></script>
<script src="~/js/site.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
