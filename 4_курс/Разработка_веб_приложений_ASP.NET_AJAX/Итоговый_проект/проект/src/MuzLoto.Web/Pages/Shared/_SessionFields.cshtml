@model MuzLoto.Web.Pages.Events.SessionForm
@{ var showGame = ViewData["ShowGame"] as bool? ?? true; }
@if (showGame)
{
    <h2>Игра</h2>
    <p class="muted">Название и описание общие для всех дат этой игры.</p>
    <label asp-for="Title">Название</label><input asp-for="Title" /><span asp-validation-for="Title" class="error-text"></span>
    <label asp-for="Description">Описание игры — каждый абзац с новой строки</label><textarea asp-for="Description" rows="6" maxlength="5000"></textarea><span asp-validation-for="Description" class="error-text"></span>
}
<h2>Дата проведения</h2>
<label asp-for="LocalStart">Дата и время (Владивосток)</label><input asp-for="LocalStart" placeholder="14.10.2026 19:00" inputmode="numeric" autocomplete="off" maxlength="16" data-datetime-mask /><span asp-validation-for="LocalStart" class="error-text"></span>
<label asp-for="Venue">Место проведения</label><input asp-for="Venue" /><span asp-validation-for="Venue" class="error-text"></span>
<label asp-for="MapUrl">Ссылка на 2ГИС</label><input asp-for="MapUrl" type="url" placeholder="https://2gis.ru/..." /><span asp-validation-for="MapUrl" class="error-text"></span>
<label asp-for="DurationMinutes">Продолжительность, минут</label><input asp-for="DurationMinutes" type="number" min="1" max="1440" /><span asp-validation-for="DurationMinutes" class="error-text"></span>
<label asp-for="AgeLimit">Возрастное ограничение</label><input asp-for="AgeLimit" type="number" min="0" max="21" /><span asp-validation-for="AgeLimit" class="error-text"></span>
<label asp-for="TicketPrice">Цена билета (₽)</label><input asp-for="TicketPrice" type="number" min="0" step="0.01" /><span asp-validation-for="TicketPrice" class="error-text"></span>
<label asp-for="Capacity">Количество мест</label><input asp-for="Capacity" type="number" min="1" /><span asp-validation-for="Capacity" class="error-text"></span>
