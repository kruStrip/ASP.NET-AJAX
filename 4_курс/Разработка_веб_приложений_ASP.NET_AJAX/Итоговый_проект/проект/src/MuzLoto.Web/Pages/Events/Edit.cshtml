@page "/events/{id:guid}/edit"
@model MuzLoto.Web.Pages.Events.EditModel
@{ ViewData["Title"] = "Редактирование игры"; }
<div class="page-heading"><div><div class="eyebrow">Расписание</div><h1>Редактирование</h1>
@if (Model.OtherDates > 0) { <p class="muted">У этой игры ещё дат: @Model.OtherDates. Название и описание изменятся во всех; дата, место и цена — только у этой.</p> }
</div></div>
<section class="panel form-panel"><form method="post">
<div asp-validation-summary="ModelOnly" class="error-text"></div>
<partial name="_SessionFields" for="Input" />
<label class="check"><input asp-for="SalesOpen" /> Продажи открыты</label>
<div class="actions"><button type="submit" class="button">Сохранить</button><a asp-page="/Events/Details" asp-route-id="@Model.SessionId" class="button secondary">Отмена</a></div>
</form></section>
