@page "/events/completed"
@model MuzLoto.Web.Pages.Events.CompleteModel
@{ ViewData["Title"] = "Завершение игр"; }
<div class="page-heading"><div><div class="eyebrow">Рабочие действия</div><h1>Отметить, что игра прошла</h1>
<p class="muted">Неподтверждённые заявки будут удалены. Оплаченные продажи сохранятся.</p></div></div>
<div class="card-list" data-live-list>
@foreach (var s in Model.Sessions)
{
<article class="booking-card" data-session-id="@s.Id"><div><h2>@s.Game.Title</h2><p class="muted">@ScheduleTime.ToLocal(s.StartsAt, s.TimeZoneId).ToString("dd.MM.yyyy HH:mm") (@s.TimeZoneId) — @s.Venue</p>
@if (s.CompletedAt.HasValue) { <span class="status cancelled">Завершено</span> }</div>
@if (!s.CompletedAt.HasValue)
{
<form method="post" data-ajax-action="game-complete" data-confirm="Удалить все неоплаченные заявки этой игры и завершить мероприятие? Удалённые заявки восстановить нельзя."><input name="id" type="hidden" value="@s.Id" />
<button class="button danger" type="submit">Игра прошла</button></form>
}
else if (User.IsInRole("Admin"))
{
<form method="post" asp-page-handler="Reopen" data-ajax-action="game-reopen" data-confirm="Отменить завершение игры? Удалённые заявки не восстановятся, продажи останутся закрытыми до ручного открытия.">
<input name="id" type="hidden" value="@s.Id" />
<button class="button secondary" type="submit">Вернуть игру в работу</button></form>
}
</article>
}
@if (Model.Sessions.Count == 0) { <p class="muted">Подходящих игр нет.</p> }
</div>
