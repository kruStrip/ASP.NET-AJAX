@page "/reports"
@model MuzLoto.Web.Pages.Reports.IndexModel
@{ ViewData["Title"] = "Отчёт"; }
<div class="page-heading"><div><div class="eyebrow">Аналитика продаж</div><h1>Отчёт</h1></div></div>
<div class="stats">
<div class="stat"><span>Продано билетов</span><strong>@Model.Sold</strong></div>
<div class="stat"><span>Подтверждено заказов</span><strong>@Model.Orders</strong></div>
<div class="stat"><span>Зафиксировано оплат</span><strong>@Model.PaymentsCount</strong></div>
<div class="stat"><span>Поступления по подтверждённым оплатам</span><strong>@Model.Revenue.ToString("N2") ₽</strong></div>
<div class="stat"><span>Средняя подтверждённая оплата</span><strong>@Model.AverageCheck.ToString("N2") ₽</strong></div>
</div>
<p class="muted">Количество действующих билетов и заказов учитывает только текущие подтверждённые бронирования. Сумма поступлений считается по зафиксированным платежам, включая отменённые заказы без подтверждённого возврата. Автоматических возвратов денег нет.</p>
