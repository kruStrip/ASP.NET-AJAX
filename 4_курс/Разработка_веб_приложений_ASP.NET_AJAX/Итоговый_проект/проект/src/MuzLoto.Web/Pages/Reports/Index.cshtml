@page "/reports"
@model MuzLoto.Web.Pages.Reports.IndexModel
@{ ViewData["Title"] = "Отчёт"; }
<div class="page-heading"><div><div class="eyebrow">Аналитика продаж</div><h1>Отчёт</h1></div></div>
<div class="stats">
<div class="stat"><span>Продано билетов</span><strong>@Model.Sold</strong></div>
<div class="stat"><span>Подтверждено заказов</span><strong>@Model.Orders</strong></div>
<div class="stat"><span>Выручка</span><strong>@Model.Revenue.ToString("N2") ₽</strong></div>
<div class="stat"><span>Средний чек</span><strong>@Model.AverageCheck.ToString("N2") ₽</strong></div>
</div>
<p class="muted">В этом этапе доступна общая сводка по действующим подтверждённым заказам. Отчёты по играм/датам и отдельный финансовый журнал появятся в следующем этапе.</p>
