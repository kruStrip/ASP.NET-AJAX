@page
@model SecureTodo.Pages.Tasks.CreateModel
@{ ViewData["Title"] = "Новая задача"; }
<h1>Новая задача</h1>
<form method="post" class="col-md-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Item.Title"></label><input asp-for="Item.Title" class="form-control" /><span asp-validation-for="Item.Title" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Item.Description"></label><textarea asp-for="Item.Description" class="form-control" rows="5"></textarea><span asp-validation-for="Item.Description" class="text-danger"></span></div>
    <button class="btn btn-primary" type="submit">Создать</button> <a class="btn btn-secondary" asp-page="Index">Отмена</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
